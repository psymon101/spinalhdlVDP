// Tang Nano 20K HDMI pin constraints for spinalhdlVDP.
// Board: Sipeed Tang Nano 20K
// FPGA:  GW2AR-LV18QN88C8/I7

IO_LOC "I_clk" 4;
IO_PORT "I_clk" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
CLOCK_LOC "I_clk_d" LOCAL_CLOCK;

IO_LOC "O_led[0]" 15;
IO_PORT "O_led[0]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "O_led[1]" 16;
IO_PORT "O_led[1]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "O_led[2]" 17;
IO_PORT "O_led[2]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "O_led[3]" 18;
IO_PORT "O_led[3]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "O_led[4]" 19;
IO_PORT "O_led[4]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "O_led[5]" 20;
IO_PORT "O_led[5]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;

// Task 44b iter 6i-r1 (CyanPeak #8166 amendment, PM option 1 from #8164):
// raise TMDS drive strength from 8 to 16 mA to harden signal integrity for
// strict HDMI receivers. SLEW attribute dropped — Gowin DS226/UG289
// (Revision 2023-02-27) notes "Information on Slew Rate removed"; CST
// parser rejects SLEW on differential TMDS ports.
IO_LOC "O_tmds_clk_p" 33,34;
IO_PORT "O_tmds_clk_p" PULL_MODE=NONE DRIVE=16 BANK_VCCIO=3.3;
IO_LOC "O_tmds_data_p[0]" 35,36;
IO_PORT "O_tmds_data_p[0]" PULL_MODE=NONE DRIVE=16 BANK_VCCIO=3.3;
IO_LOC "O_tmds_data_p[1]" 37,38;
IO_PORT "O_tmds_data_p[1]" PULL_MODE=NONE DRIVE=16 BANK_VCCIO=3.3;
IO_LOC "O_tmds_data_p[2]" 39,40;
IO_PORT "O_tmds_data_p[2]" PULL_MODE=NONE DRIVE=16 BANK_VCCIO=3.3;

// QSPI host-control frontend — full 4-wire quad-mode.
// Remapped 2026-07-10 to the ESP32-P4 transport harness wiring confirmed by
// BronzeGate (#13953): P4 GPIO CS=20/SCLK=21/IO0=32/IO1=33/IO2=22/IO3=23 are
// wired to Tang pins CS=85, SCK=77, IO0..3=25/26/27/28. The legacy VDP
// mapping (42/41/48/49/51/54) is not connected to the current bench.
// Pull-downs on data lines so unwired inputs read 0 instead of floating.
IO_LOC  "I_qspi_cs"  85;
IO_PORT "I_qspi_cs"  IO_TYPE=LVCMOS33 PULL_MODE=UP  BANK_VCCIO=3.3;
IO_LOC  "I_qspi_sck" 77;
IO_PORT "I_qspi_sck" IO_TYPE=LVCMOS33 PULL_MODE=DOWN BANK_VCCIO=3.3;
IO_LOC  "IO_qspi_io0" 25;
IO_PORT "IO_qspi_io0" IO_TYPE=LVCMOS33 PULL_MODE=DOWN BANK_VCCIO=3.3;
IO_LOC  "IO_qspi_io1" 26;
IO_PORT "IO_qspi_io1" IO_TYPE=LVCMOS33 PULL_MODE=DOWN BANK_VCCIO=3.3;
IO_LOC  "IO_qspi_io2" 27;
IO_PORT "IO_qspi_io2" IO_TYPE=LVCMOS33 PULL_MODE=DOWN BANK_VCCIO=3.3;
IO_LOC  "IO_qspi_io3" 28;
IO_PORT "IO_qspi_io3" IO_TYPE=LVCMOS33 PULL_MODE=DOWN BANK_VCCIO=3.3;
