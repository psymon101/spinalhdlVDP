// Tang Nano 20K HDMI pin constraints for spinalhdlVDP.
// Board: Sipeed Tang Nano 20K
// FPGA:  GW2AR-LV18QN88C8/I7

IO_LOC "I_clk" 4;
IO_PORT "I_clk" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
CLOCK_LOC "I_clk_d" LOCAL_CLOCK;

IO_LOC "O_led[0]" 15;
IO_PORT "O_led[0]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "O_led[1]" 16;
IO_PORT "O_led[1]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "O_led[2]" 17;
IO_PORT "O_led[2]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "O_led[3]" 18;
IO_PORT "O_led[3]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "O_led[4]" 19;
IO_PORT "O_led[4]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "O_led[5]" 20;
IO_PORT "O_led[5]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;

IO_LOC "O_tmds_clk_p" 33,34;
IO_PORT "O_tmds_clk_p" PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "O_tmds_data_p[0]" 35,36;
IO_PORT "O_tmds_data_p[0]" PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "O_tmds_data_p[1]" 37,38;
IO_PORT "O_tmds_data_p[1]" PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "O_tmds_data_p[2]" 39,40;
IO_PORT "O_tmds_data_p[2]" PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

// QSPI host-control frontend — full 4-wire quad-mode.
// Pin mapping inherited from the proven VDP project tang20k.cst.
// Wiring: Pico GP8/9/10/11/12/13 -> Tang pins 41/42/48/49/51/54.
// Pull-downs on data lines so unwired inputs read 0 instead of floating.
IO_LOC  "I_qspi_cs"  42;
IO_PORT "I_qspi_cs"  IO_TYPE=LVCMOS33 PULL_MODE=UP  BANK_VCCIO=3.3;
IO_LOC  "I_qspi_sck" 41;
IO_PORT "I_qspi_sck" IO_TYPE=LVCMOS33 PULL_MODE=DOWN BANK_VCCIO=3.3;
IO_LOC  "I_qspi_io0" 48;
IO_PORT "I_qspi_io0" IO_TYPE=LVCMOS33 PULL_MODE=DOWN BANK_VCCIO=3.3;
IO_LOC  "I_qspi_io1" 49;
IO_PORT "I_qspi_io1" IO_TYPE=LVCMOS33 PULL_MODE=DOWN BANK_VCCIO=3.3;
IO_LOC  "I_qspi_io2" 51;
IO_PORT "I_qspi_io2" IO_TYPE=LVCMOS33 PULL_MODE=DOWN BANK_VCCIO=3.3;
IO_LOC  "I_qspi_io3" 54;
IO_PORT "I_qspi_io3" IO_TYPE=LVCMOS33 PULL_MODE=DOWN BANK_VCCIO=3.3;
